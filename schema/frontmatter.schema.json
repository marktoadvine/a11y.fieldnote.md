{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/marktoadvine/accessibility-fieldnote-schema/main/schema/frontmatter.schema.json",
  "title": "AFS Markdown frontmatter 0.4.0",
  "description": "Metadata for Markdown fieldnotes. Custom fields are welcome.",
  "type": "object",
  "additionalProperties": true,
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "appliesTo": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text"
      },
      "description": "Declared configuration IDs. Omit to apply to all documented configurations. Additive; no overrides."
    }
  },
  "required": [
    "schemaVersion",
    "component"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "schemaVersion": {
      "const": "0.4.0"
    },
    "component": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "platform": {
          "$ref": "#/$defs/text",
          "description": "Project-defined platform such as web, ios, android, or desktop."
        },
        "version": {
          "$ref": "#/$defs/text"
        },
        "references": {
          "type": "array",
          "description": "Links to design nodes, component previews, source directories, or other context.",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "kind": {
                "$ref": "#/$defs/text"
              },
              "label": {
                "$ref": "#/$defs/text"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "path": {
                "$ref": "#/$defs/text"
              }
            },
            "anyOf": [
              {
                "required": [
                  "url"
                ]
              },
              {
                "required": [
                  "path"
                ]
              }
            ]
          }
        }
      },
      "required": [
        "id",
        "platform"
      ]
    },
    "configurations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": {
            "$ref": "#/$defs/text"
          },
          "name": {
            "$ref": "#/$defs/text"
          },
          "context": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": true
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "description": "Explicit named variants/states; not exhaustive coverage. Context is informational only."
    },
    "benchmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "name": {
            "$ref": "#/$defs/text"
          },
          "version": {
            "$ref": "#/$defs/text"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "name",
          "version",
          "url"
        ]
      },
      "description": "Sources informing the record; no coverage or conformance claim."
    },
    "notes": false,
    "checks": false
  }
}
